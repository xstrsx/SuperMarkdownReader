{
  "name": "litedoc-web",
  "private": true,
  "version": "0.1.0",
  "description": "LiteDoc offline rendering shell (bundled into the APK by the Android build)",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.3 <23"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node ../scripts/build-web.mjs",
    "verify:closure": "node ../scripts/verify-resource-closure.mjs",
    "verify:mermaid": "node ../scripts/collect-mermaid-types.mjs --check",
    "test:markdown": "node ../scripts/test-markdown-pipeline.mjs",
    "test:sanitizers": "node ../scripts/test-sanitizers.mjs",
    "verify:licences": "node ../scripts/collect-licences.mjs",
    "fixtures:mermaid": "node ../scripts/generate-fixtures.mjs --mermaid"
  },
  "dependencies": {
    "@mathjax/mathjax-mhchem-font-extension": "4.1.3",
    "css-tree": "3.2.1",
    "dompurify": "3.4.16",
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.2",
    "markdown-it-deflist": "4.0.0",
    "markdown-it-emoji": "3.1.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-ins": "4.0.0",
    "markdown-it-mark": "4.0.0",
    "markdown-it-sub": "2.0.0",
    "markdown-it-sup": "2.0.0",
    "markdown-it-task-lists": "2.1.1",
    "mathjax": "4.1.3",
    "mermaid": "12.0.0",
    "papaparse": "5.7.0",
    "smiles-drawer": "2.4.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/papaparse": "5.3.16",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
