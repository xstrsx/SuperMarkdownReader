<?xml version="1.0" encoding="utf-8"?>
<!--
  LiteDoc manifest.

  Deliberate properties:
  * No MAIN / LAUNCHER activity: the app is only reachable through "Open with"
    and "Share" (ACTION_VIEW / ACTION_SEND / ACTION_SEND_MULTIPLE).
  * No BROWSABLE category and no http/https intent filter: LiteDoc never
    presents itself as a web browser and can never be opened with a web URL.
  * No `*/*` intent filter, so LiteDoc does not appear in the "open with" list
    of every file type. Types that senders commonly mistype fall back to
    "share as text" or "open with" from a file manager that reports text/* or
    application/octet-stream (see docs/support-matrix.md).
  * INTERNET is the only permission. It is used exclusively by the restricted
    native image proxy (image/ package); the WebView itself never reaches the
    network (blockNetworkLoads + a closed request router).
  * Cleartext HTTP is permitted for the native image client only, because
    documents may reference http images. The WebView cannot use it: every
    unrecognised request is rejected inside shouldInterceptRequest.
    See docs/security.md and docs/adr/0004-network-image-policy.md.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.software.webview"
        android:required="true" />

    <application
        android:name=".LiteDocApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_litedoc"
        android:label="@string/app_name"
        android:largeHeap="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiteDoc"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ViewerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|fontScale|density|locale|layoutDirection"
            android:exported="true"
            android:icon="@drawable/ic_litedoc"
            android:label="@string/app_name"
            android:launchMode="standard"
            android:theme="@style/Theme.LiteDoc"
            android:windowSoftInputMode="adjustResize">

            <!-- ACTION_VIEW: text documents and source code sent by file managers -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>

            <!-- ACTION_VIEW: SVG and structured text formats with their own MIME types -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/svg+xml" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="application/yaml" />
                <data android:mimeType="application/x-tex" />
                <data android:mimeType="application/x-latex" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- Legacy file:// compatibility (only for genuinely readable files) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/svg+xml" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- ACTION_SEND: "Share to LiteDoc" -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/svg+xml" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="application/yaml" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- ACTION_SEND_MULTIPLE: multi-file share -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/svg+xml" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="application/yaml" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
    </application>
</manifest>
